NODE_ENV="development"
DATABASE_URL=""

# Public origins (no trailing slash). In dev, admin.localhost resolves to 127.0.0.1 in modern browsers.
APP_URL="http://localhost:3000"
ADMIN_URL="http://admin.localhost:3000"

# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Also used to sign guest order-tracking links. Keep it stable.
TOTP_ENCRYPTION_KEY=""


# Dev only: skip email verification at signup (ignored in production)
DEV_AUTO_VERIFY_EMAIL="false"

# Email (Resend). Leave empty in dev to log emails to the console.
RESEND_API_KEY=""
EMAIL_FROM=""

# Used only by `npm run admin:seed`
SEED_ADMIN_EMAIL=""
SEED_ADMIN_NAME=""
SEED_ADMIN_PASSWORD=""

# Payments (server-side only, never NEXT_PUBLIC_)
PAYSTACK_SECRET_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_HASH=""

# Image storage: any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2...)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Protects POST /api/cron/release-stock (call every 10 min from a scheduler)
CRON_SECRET=""
